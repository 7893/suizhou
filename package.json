{
	"name": "suizhou",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit && node scripts/fonts.mjs --verify",
		"test": "node --test tests/*.test.mjs",
		"test:browser": "playwright test",
		"build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
		"fonts": "node scripts/fonts.mjs",
		"dev": "vite",
		"preview": "vite preview --port 4173 --strictPort",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.63.0",
		"fontkit": "2.0.4",
		"playwright": "1.63.0",
		"subset-font": "2.9.0",
		"typescript": "7.0.2",
		"vite": "8.3.8"
	},
	"dependencies": {
		"@esotericsoftware/spine-pixi-v8": "4.2.120",
		"animejs": "4.5.0",
		"pixi.js": "8.21.0"
	}
}
